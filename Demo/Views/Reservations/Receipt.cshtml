@model Demo.Models.Reservation

@{
    Layout = null; // No layout for cleaner printing
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/css/receipt.css" />
    <title>E-Receipt</title>
</head>
<body>
    <div class="print-btn">
        <button onclick="window.print()">🖨️ Print / Save as PDF</button>
    </div>

    <div class="receipt">
        <h2>Yobita</h2>
        <h3>E-Receipt</h3>
        <hr />
        <p><strong>Reservation ID:</strong> @Model.ReservationId</p>
        <p><strong>Name:</strong> @Model.User.Name</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Room:</strong> @Model.Room.RoomId - @Model.Room.RoomType.Name</p>
        <p><strong>Check-In:</strong> @Model.CheckIn.ToString("dd MMM yyyy")</p>
        <p><strong>Check-Out:</strong> @Model.CheckOut.ToString("dd MMM yyyy")</p>
        <p><strong>Total Price:</strong> @Model.TotalPrice.ToString("C")</p>
        <p><strong>Status:</strong> @Model.Status</p>
        <hr />
        <p class="text-center">Thank you for choosing our hotel!</p>
    </div>
</body>
</html>
