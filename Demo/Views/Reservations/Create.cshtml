@model Demo.Controllers.CreateReservationViewModel

@{
    ViewData["Title"] = "Create Reservation";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/reservation.css" />
}

<div class="reservation-container">
    <h1>Create Reservation</h1>
    <h4>Room @Model.RoomId - @Model.RoomTypeName</h4>
</div>

<div class="reservation-content">
    <div class="row">
        <div class="col-md-6">
            <form asp-controller="Reservations" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <!-- Debugging info (optional for development) -->
                <div class="alert alert-info">
                    <strong>Debug Info:</strong><br />
                    RoomId: @Model.RoomId<br />
                    TypeId: @(string.IsNullOrEmpty(Model.TypeId) ? "Not loaded" : Model.TypeId)<br />
                    RoomType: @(string.IsNullOrEmpty(Model.RoomTypeName) ? "NULL" : Model.RoomTypeName)<br />
                    Price: @Model.Price.ToString("C")
                </div>

                <!-- Validation summary -->
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <input type="hidden" asp-for="RoomId" />
                <input type="hidden" asp-for="TypeId" />
                <input type="hidden" asp-for="RoomTypeName" />
                <input type="hidden" asp-for="Price" />

                <div class="form-group">
                    <label asp-for="RoomTypeName" class="control-label">Room Type</label>
                    <input asp-for="RoomTypeName" class="form-control" disabled />
                </div>

                <div class="form-group">
                    <label asp-for="Price" class="control-label">Price per night</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text">$</span>
                        </div>
                        <input asp-for="Price" class="form-control" disabled />
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="CheckInDate" class="control-label">Check-In Date</label>
                    <input asp-for="CheckInDate" class="form-control" id="CheckInDate" />
                    <span asp-validation-for="CheckInDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CheckOutDate" class="control-label">Check-Out Date</label>
                    <input asp-for="CheckOutDate" class="form-control" id="CheckOutDate" />
                    <span asp-validation-for="CheckOutDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Create Reservation</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to Availability</a>
                </div>
            </form>

            <!-- Placeholder for total price -->
            <div id="totalPriceContainer" class="alert alert-info mt-3 d-none"></div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            var today = new Date().toISOString().split('T')[0];
            $('#CheckInDate').attr('min', today);

            $('#CheckInDate').on('change', function () {
                var checkIn = $(this).val();
                $('#CheckOutDate').attr('min', checkIn);

                // Adjust Check-Out if earlier
                var currentOut = $('#CheckOutDate').val();
                if (new Date(currentOut) <= new Date(checkIn)) {
                    var nextDay = new Date(checkIn);
                    nextDay.setDate(nextDay.getDate() + 1);
                    $('#CheckOutDate').val(nextDay.toISOString().split('T')[0]);
                }

                calculateTotal();
            });

            $('#CheckOutDate').on('change', calculateTotal);

            function calculateTotal() {
                var checkIn = new Date($('#CheckInDate').val());
                var checkOut = new Date($('#CheckOutDate').val());

                if (checkIn && checkOut && checkOut > checkIn) {
                    var nights = (checkOut - checkIn) / (1000 * 60 * 60 * 24);
                    var pricePerNight = @Model.Price;
                    var total = nights * pricePerNight;

                    $('#totalPriceContainer')
                        .removeClass('d-none')
                        .html('<strong>Total:</strong> $<span id="totalPrice">' +
                            total.toFixed(2) + '</span> for ' + nights + ' night(s)');
                }
            }

            // Prevent double submit
            $('form').on('submit', function () {
                $(this).find('button[type="submit"]').prop('disabled', true);
            });

            // Calculate total if dates are pre-filled
            if ($('#CheckInDate').val() && $('#CheckOutDate').val()) {
                calculateTotal();
            }
        });
    </script>
}
