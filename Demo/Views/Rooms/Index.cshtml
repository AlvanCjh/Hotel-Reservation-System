@{
    Layout = "_Layout";
    ViewData["Title"] = "Rooms";
}
<link rel="stylesheet" href="~/css/rooms.css" />

<section class="room-section">
    <h1 class="section-title">Our Rooms</h1>

    <div class="room-grid">
        <div class="room-card">
            <img src="~/images/Room1.png" alt="Single Room" />
            <h3>Single Room</h3>
            <p>Perfect for solo travelers, featuring a cozy single bed, workspace, and city view.</p>
        </div>

        <div class="room-card">
            <img src="~/images/room2.png" alt="Double Room" />
            <h3>Double Room</h3>
            <p>Spacious room with a double bed, great for couples or close friends. Includes all amenities.</p>
        </div>

        <div class="room-card">
            <img src="~/images/room3.png" alt="Family Room" />
            <h3>Family Room</h3>
            <p>Large room with multiple beds and extra space, ideal for family vacations.</p>
        </div>

        <div class="room-card">
            <img src="~/images/room4.png" alt="Suite" />
            <h3>Luxury Suite</h3>
            <p>Our premium suite with a private lounge, king-sized bed, luxury bath, and complimentary services.</p>
        </div>
    </div>
</section>
