@model Demo.Models.ReservationDetailViewModel
@{
    ViewData["Title"] = "Reservation Details";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/userManage.css" />

<div class="admin-container">
    <h1>Reservation Details</h1>
    <p class="admin-subtitle">Read-only view</p>

    <div style="max-width: 700px; margin: auto; margin-top:20px;">
        <dl class="row" style="gap:10px;">
            <div class="col-12 mb-2">
                <strong>Reservation ID:</strong> @Model.ReservationId
            </div>
            <div class="col-6 mb-2">
                <strong>User:</strong> @Model.UserName (@Model.UserEmail)
            </div>
            <div class="col-6 mb-2">
                <strong>Room:</strong> @Model.RoomId
            </div>
            <div class="col-6 mb-2">
                <strong>Room Type:</strong> @Model.RoomTypeName
            </div>
            <div class="col-6 mb-2">
                <strong>Check-In:</strong> @Model.CheckIn.ToString("yyyy-MM-dd")
            </div>
            <div class="col-6 mb-2">
                <strong>Check-Out:</strong> @Model.CheckOut.ToString("yyyy-MM-dd")
            </div>
            <div class="col-6 mb-2">
                <strong>Total Price:</strong> @Model.TotalPrice.ToString("C")
            </div>
            <div class="col-6 mb-2">
                <strong>Status:</strong> @Model.Status
            </div>
        </dl>

        <div style="margin-top:20px;">
            <a asp-action="ReservationManage" class="btn btn-view" style="background-color:#bdc3c7; color:#2c3e50;">
                <i class="fas fa-arrow-left"></i> Back to list
            </a>
        </div>
    </div>
</div>
