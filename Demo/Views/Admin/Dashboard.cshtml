@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<head>
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>

<div class="admin-dashboard">
    <h1>Welcome, @ViewBag.AdminName!</h1>
    <p class="text-muted">Admin Control Panel</p>

    <div class="admin-cards">
        <div class="admin-card">
            <h3>User Management</h3>
            <p>Manage all registered users</p>
            <a asp-controller="Admin" asp-action="UserManage" class="btn btn-primary">Go to Users</a>
        </div>

        <div class="admin-card">
            <h3>Reservation Management</h3>
            <p>Manage all reservations</p>
            <a asp-controller="Admin" asp-action="ReservationManage" class="btn btn-primary">Go to Reservation</a>
        </div>

        <div class="admin-card">
            <h3>Room Management</h3>
            <p>Manage all rooms</p>
            <a asp-controller="Admin" asp-action="RoomManage" class="btn btn-primary">Go to Rooms</a>
        </div>
    </div>
</div>
