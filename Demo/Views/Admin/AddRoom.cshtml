@model Demo.Models.RoomCreateEditViewModel

@{
    ViewData["Title"] = "Add Room";
    Layout = "_Layout";
}

<head>
    <link rel="stylesheet" href="~/css/userManage.css" />
</head>

<div class="admin-container">
    <h1>Add New Room</h1>
    <p class="admin-subtitle">Create a new room and assign a type</p>

    <div class="form-container" style="max-width: 600px; margin: auto; margin-top: 20px;">
        <form asp-action="AddRoom" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group" style="margin-bottom: 18px;">
                <label asp-for="RoomId"></label>
                <input asp-for="RoomId" class="form-control" placeholder="e.g., R001" />
                <span asp-validation-for="RoomId" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-bottom: 18px;">
                <label asp-for="TypeId">Room Type</label>
                <select asp-for="TypeId" class="form-control" asp-items="Model.RoomTypeItems">
                    <option value="">-- Select Type --</option>
                </select>
                <span asp-validation-for="TypeId" class="text-danger"></span>
            </div>

            <!-- ✅ Add missing Description -->
            <div class="form-group" style="margin-bottom: 18px;">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- ✅ Add file upload -->
            <div class="form-group" style="margin-bottom: 18px;">
                <label asp-for="UploadedImages">Upload Images</label>
                <input asp-for="UploadedImages" type="file" class="form-control" multiple />
                <span asp-validation-for="UploadedImages" class="text-danger"></span>
            </div>

            <div style="margin-top: 24px;">
                <button type="submit" class="btn btn-view" style="background-color:#27ae60;">
                    <i class="fas fa-save"></i> Save
                </button>
                <a asp-action="RoomManage" class="btn" style="margin-left:10px; text-decoration:none; padding:8px 14px; background:#bdc3c7; color:#2c3e50; border-radius:6px;">
                    Cancel
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
