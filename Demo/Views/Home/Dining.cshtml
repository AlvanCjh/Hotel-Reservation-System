@{
    Layout = "_Layout";
    ViewData["Title"] = "Dining";
}

<link rel="stylesheet" href="~/css/rooms.css" />

<section class="room-section">
    <h1 class="section-title">Dining Experience</h1>

    <div class="room-grid">
        <div class="room-card">
            <img src="~/images/Res1.png" alt="Breakfast" />
            <h3>Breakfast Buffet</h3>
            <p>Start your day with a wide selection of fresh pastries, hot dishes, seasonal fruits, and refreshing beverages—all served in our relaxing dining hall.</p>
        </div>

        <div class="room-card">
            <img src="~/images/Res2.png" alt="High Tea" />
            <h3>High Tea</h3>
            <p>Enjoy an elegant afternoon with premium teas, delicate finger sandwiches, warm scones, and an assortment of sweet treats prepared by our chefs.</p>
        </div>

        <div class="room-card">
            <img src="~/images/res3.png" alt="Dining" />
            <h3>Fine Dining</h3>
            <p>Indulge in a sophisticated culinary experience with expertly crafted gourmet dishes, fine wines, and attentive service in an intimate setting.</p>
        </div>

        <div class="room-card">
            <img src="~/images/res4.png" alt="Hot Pot" />
            <h3>Hot Pot</h3>
            <p>Gather around a steaming hot pot filled with rich broth, fresh vegetables, meats, and seafood—perfect for a warm and interactive dining experience.</p>
        </div>
    </div>
</section>
