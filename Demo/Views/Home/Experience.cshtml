@{
    Layout = "_Layout";
    ViewData["Title"] = "Experience";
}

<link rel="stylesheet" href="~/css/rooms.css" />

<section class="room-section">
    <h1 class="section-title">Hotel Lifestyle</h1>

    <div class="room-grid">
        <div class="room-card">
            <img src="~/images/spa.png" alt="Spa" />
            <h3>Spa</h3>
            <p>A tranquil retreat offering relaxing treatments and therapies to refresh your body and mind.</p>
        </div>

        <div class="room-card">
            <img src="~/images/swim.png" alt="Swimming Pool" />
            <h3>Swimming Pool</h3>
            <p>A refreshing outdoor pool perfect for leisure, exercise, or simply soaking up in a spacious environment</p>
        </div>

        <div class="room-card">
            <img src="~/images/gym.png" alt="Gym" />
            <h3>Gym</h3>
            <p>A modern fitness center equipped with cardio and strength-training machines for a complete workout.</p>
        </div>

        <div class="room-card">
            <img src="~/images/garden.png" alt="Garden" />
            <h3>Spacious Garden</h3>
            <p>A peaceful green space where guests can relax, stroll, or enjoy the natural surroundings.</p>
        </div>
    </div>
</section>
