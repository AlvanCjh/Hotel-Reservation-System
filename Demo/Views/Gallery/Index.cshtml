@{
    Layout = "_Layout";
    ViewData["Title"] = "Gallery";
}

<head>
    <link href="~/css/gallery.css" rel="stylesheet" />
</head>

<h2 class="page-title">@ViewData["Title"]</h2>

<!-- Gallery Section -->
<div class="gallery-section">

    <!-- Hotel Category -->
    <div class="gallery-category">
        <h2>Hotel</h2>
        <div class="gallery-items">
            <div class="gallery-card">
                <img src="~/images/Hotel image 1.png" alt="Hotel Image 1">
            </div>
            <div class="gallery-card">
                <img src="~/images/Hotel image 2.png" alt="Hotel Image 2">
            </div>
            <div class="gallery-card">
                <img src="~/images/Hotel image 3.png" alt="Hotel Image 3">
            </div>
        </div>
    </div>

    <!-- Rooms Category -->
    <div class="gallery-category">
        <h2>Rooms</h2>
        <div class="gallery-items">
            <div class="gallery-card">
                <img src="~/images/Room image 1.png" alt="Room Image 1">
            </div>
            <div class="gallery-card">
                <img src="~/images/Room image 2.png" alt="Room Image 2">
            </div>
            <div class="gallery-card">
                <img src="~/images/Room image 3.png" alt="Room Image 3">
            </div>
            <div class="gallery-card">
                <img src="~/images/Room image 4.png" alt="Room Image 4">
            </div>
            <div class="gallery-card">
                <img src="~/images/Room image 5.png" alt="Room Image 5">
            </div>
        </div>
    </div>

    <!-- Dining Category -->
    <div class="gallery-category">
        <h2>Dining</h2>
        <div class="gallery-items">
            <div class="gallery-card">
                <img src="~/images/Dining image 1.png" alt="Dining Image 1">
            </div>
            <div class="gallery-card">
                <img src="~/images/Dining image 2.png" alt="Dining Image 2">
            </div>
            <div class="gallery-card">
                <img src="~/images/Dining image 3.png" alt="Dining Image 3">
            </div>
        </div>
    </div>

</div>
